# ai/ is workspace data. Runtime/generated data stays ignored, but the active
# V2 workspace definition and knowledge/content layers are tracked.
# Negation chain required: git cannot re-include inside an excluded directory.
/ai/*
!/ai/RC-MacAir-15/
/ai/RC-MacAir-15/Data/
!/ai/RC-MacAir-15/Views/
!/ai/RC-MacAir-15/Wiki/
!/ai/RC-MacAir-15/Captures/
!/ai/RC-MacAir-15/Issues/
!/ai/RC-MacAir-15/Agents/
!/ai/RC-MacAir-15/System/
**/threads.json
**/history.json
# Runtime database and chat artifacts
fusion-studio-server/data/*.db
fusion-studio-server/data/*.db-journal
fusion-studio-server/data/*.db-wal
# Large bundled binaries — download at build time, never commit
fusion-studio-client/electron/resources/pandoc/
fusion-studio-client/electron/resources/models/
