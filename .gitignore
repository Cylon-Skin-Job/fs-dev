# ai/ is runtime/workspace data — ignored, EXCEPT the wiki (knowledge layer, backed up to GitHub).
# Negation chain required: git cannot re-include inside an excluded directory.
/ai/*
!/ai/views/
/ai/views/*
!/ai/views/wiki-viewer/
/ai/views/wiki-viewer/*
!/ai/views/wiki-viewer/Wiki/
