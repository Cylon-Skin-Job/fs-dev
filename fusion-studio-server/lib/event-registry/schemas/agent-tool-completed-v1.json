{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fusion://schemas/event/agent.tool_completed/v1",
  "title": "AgentToolCompletedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "workspaceId", "operationId", "origin", "thread", "tool", "timing", "resources", "candidatesTruncated"],
  "properties": {
    "eventId": { "$ref": "#/$defs/uuid" },
    "eventType": { "const": "agent.tool_completed" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "$ref": "#/$defs/timestamp" },
    "workspaceId": { "$ref": "#/$defs/id128" },
    "operationId": { "$ref": "#/$defs/uuid" },
    "origin": { "$ref": "#/$defs/origin" },
    "thread": { "$ref": "#/$defs/thread" },
    "tool": { "$ref": "#/$defs/tool" },
    "timing": { "$ref": "#/$defs/timing" },
    "resources": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/resource" } },
    "candidatesTruncated": { "type": "boolean" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id128": { "type": "string", "minLength": 1, "maxLength": 128 },
    "toolCallId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "timestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "accessFamily": { "enum": ["read", "write", "execute", "unknown"] },
    "accessKind": { "enum": ["read", "write", "create", "delete", "move_from", "move_to", "execute", "unknown"] },
    "extractionBasis": { "enum": ["structured_path", "shell_input_redirection", "shell_output_redirection", "shell_known_operand"] },
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "harnessId", "provider", "assurance"],
      "properties": {
        "kind": { "const": "agent_harness" }, "harnessId": { "$ref": "#/$defs/id128" },
        "provider": { "$ref": "#/$defs/id128" }, "assurance": { "const": "adapter_observed" }
      }
    },
    "thread": {
      "type": "object", "additionalProperties": false, "required": ["threadId", "turnId"],
      "properties": { "threadId": { "$ref": "#/$defs/id128" }, "turnId": { "$ref": "#/$defs/id128" } }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["toolCallId", "name", "nativeName", "status"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" }, "name": { "$ref": "#/$defs/id128" },
        "nativeName": { "$ref": "#/$defs/id128" },
        "status": { "enum": ["completed", "error", "blocked", "interrupted"] },
        "argumentsSha256": { "$ref": "#/$defs/sha256" }, "resultSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["announcedObservedAt", "terminalObservedAt"],
      "properties": {
        "announcedObservedAt": { "$ref": "#/$defs/timestamp" }, "announcedReportedAt": { "$ref": "#/$defs/timestamp" },
        "executionStartedReportedAt": { "$ref": "#/$defs/timestamp" }, "argumentsObservedAt": { "$ref": "#/$defs/timestamp" },
        "argumentsReportedAt": { "$ref": "#/$defs/timestamp" }, "terminalObservedAt": { "$ref": "#/$defs/timestamp" },
        "terminalReportedAt": { "$ref": "#/$defs/timestamp" }, "terminalSnapshotReportedAt": { "$ref": "#/$defs/timestamp" },
        "reconciledAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["edgeId", "candidateSha256", "accessFamily", "accessKind", "extractionBasis"],
      "properties": {
        "edgeId": { "$ref": "#/$defs/uuid" }, "path": { "$ref": "#/$defs/path" },
        "candidateSha256": { "$ref": "#/$defs/sha256" }, "accessFamily": { "$ref": "#/$defs/accessFamily" },
        "accessKind": { "$ref": "#/$defs/accessKind" }, "extractionBasis": { "$ref": "#/$defs/extractionBasis" },
        "rejectionReason": { "enum": ["outside_workspace", "invalid_path", "blocked_before_execution"] }
      },
      "allOf": [
        { "if": { "required": ["rejectionReason"] }, "then": { "if": { "properties": { "rejectionReason": { "enum": ["outside_workspace", "invalid_path"] } }, "required": ["rejectionReason"] }, "then": { "not": { "required": ["path"] } } } },
        { "if": { "not": { "required": ["rejectionReason"] } }, "then": { "required": ["path"] } }
      ]
    }
  }
}
