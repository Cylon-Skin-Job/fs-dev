{"type":"before","callId":"call@10","startTime":72771.003,"class":"Frame","method":"addScriptTag","params":{"content":"(function() {\n  \"use strict\";\n  var __vite_style__ = document.createElement(\"style\");\n  __vite_style__.textContent = `/**\n * Universal Hover Icon Modal Styles\n * \n * All hover-triggered icon modals share these variables and base styles.\n * Modify these variables to change all modals at once.\n */\n\n:root {\n  /* Modal dimensions */\n  --hover-modal-width: 600px;\n  --hover-modal-max-height: 480px;\n  --hover-modal-min-height: 200px;\n  \n  /* Modal positioning */\n  --hover-modal-offset: 12px;\n  \n  /* Colors - Neutral only, no blues */\n  --hover-modal-bg: var(--sidebar-surface-bg, #161616);\n  --hover-modal-border: var(--neutral-chrome-border, #333);\n  --hover-modal-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);\n  \n  /* Row styling */\n  --hover-modal-row-height: 48px;\n  --hover-modal-row-padding: 8px 16px;\n  --hover-modal-row-hover-bg: var(--neutral-chrome-bg, #222);\n  --hover-modal-row-selected-bg: var(--neutral-chrome-bg, #222);\n  --hover-modal-row-border: var(--neutral-chrome-border, #333);\n  \n  /* Header */\n  --hover-modal-header-padding: 12px 16px;\n  --hover-modal-header-border: var(--neutral-chrome-border, #333);\n  \n  /* Typography */\n  --hover-modal-title-size: 13px;\n  --hover-modal-title-weight: 500;\n  --hover-modal-title-color: var(--text-primary, #fff);\n  --hover-modal-item-size: 13px;\n  --hover-modal-item-color: var(--chrome-accent, var(--text-dim));\n  --hover-modal-meta-size: 12px;\n  --hover-modal-meta-color: var(--text-dim, #888);\n  --hover-modal-hint-size: 12px;\n  --hover-modal-hint-color: var(--text-dim, #888);\n  \n  /* Thumbnail sizing */\n  --hover-modal-thumb-size: 48px;\n  --hover-modal-thumb-radius: 4px;\n  \n  /* Scrollbar - canonical workspace tokens (variables.css). */\n  --hover-modal-scrollbar-width: 8px;\n  --hover-modal-scrollbar-track:       var(--scrollbar-track, transparent);\n  --hover-modal-scrollbar-thumb:       var(--scrollbar-thumb, rgba(255, 255, 255, 0.12));\n  --hover-modal-scrollbar-thumb-hover: var(--scrollbar-thumb-hover, rgba(255, 255, 255, 0.22));\n  \n  /* Preview popover */\n  --hover-modal-preview-width: 400px;\n  --hover-modal-preview-max-height: 300px;\n}\n\n/* Base Modal Container */\n.rv-hover-icon-modal {\n  position: fixed;\n  left: var(--modal-left);\n  bottom: var(--modal-bottom);\n  width: var(--hover-modal-width);\n  max-height: var(--hover-modal-max-height);\n  min-height: var(--hover-modal-min-height);\n  background: var(--hover-modal-bg);\n  border: 1px solid var(--hover-modal-border);\n  border-radius: 8px;\n  box-shadow: var(--hover-modal-shadow);\n  z-index: var(--z-modal, 1003);\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  transform: translateY(8px);\n  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n.rv-hover-icon-modal.open {\n  opacity: 1;\n  visibility: visible;\n  pointer-events: auto;\n  transform: translateY(0);\n}\n\n/* Header */\n.rv-hover-icon-modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--hover-modal-header-padding);\n  border-bottom: 1px solid var(--hover-modal-header-border);\n  flex-shrink: 0;\n}\n\n.rv-hover-icon-modal-title {\n  font-size: var(--hover-modal-title-size);\n  font-weight: var(--hover-modal-title-weight);\n  color: var(--hover-modal-title-color);\n}\n\n.rv-hover-icon-modal-action {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n  padding: 0;\n  background: transparent;\n  border: none;\n  border-radius: 4px;\n  color: var(--text-dim);\n  cursor: pointer;\n  transition: background 0.15s, color 0.15s;\n}\n\n.rv-hover-icon-modal-action:hover {\n  background: var(--hover-modal-row-hover-bg);\n  color: var(--text-primary);\n}\n\n.rv-hover-icon-modal-action .material-symbols-outlined {\n  font-size: 16px;\n}\n\n/* Content List */\n.rv-hover-icon-modal-list {\n  flex: 1;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Scrollbar styling */\n.rv-hover-icon-modal-list::-webkit-scrollbar {\n  width: var(--hover-modal-scrollbar-width);\n}\n\n.rv-hover-icon-modal-list::-webkit-scrollbar-track {\n  background: var(--hover-modal-scrollbar-track);\n}\n\n.rv-hover-icon-modal-list::-webkit-scrollbar-thumb {\n  background: var(--hover-modal-scrollbar-thumb);\n  border-radius: 4px;\n}\n\n.rv-hover-icon-modal-list::-webkit-scrollbar-thumb:hover {\n  background: var(--hover-modal-scrollbar-thumb-hover);\n}\n\n/* Row */\n.rv-hover-icon-modal-row {\n  display: flex;\n  align-items: center;\n  padding: var(--hover-modal-row-padding);\n  min-height: var(--hover-modal-row-height);\n  border-bottom: 1px solid var(--hover-modal-row-border);\n  text-decoration: none;\n  color: inherit;\n  cursor: pointer;\n  transition: background-color 0.15s;\n  gap: 12px;\n}\n\n.rv-hover-icon-modal-row:last-child {\n  border-bottom: none;\n}\n\n.rv-hover-icon-modal-row:hover,\n.rv-hover-icon-modal-row.selected {\n  background: var(--hover-modal-row-hover-bg);\n}\n\n/* Thumbnail */\n.rv-hover-icon-modal-thumb {\n  width: var(--hover-modal-thumb-size);\n  height: var(--hover-modal-thumb-size);\n  flex-shrink: 0;\n  border-radius: var(--hover-modal-thumb-radius);\n  overflow: hidden;\n  background: var(--panel-bg);\n}\n\n.rv-hover-icon-modal-thumb img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* Content area */\n.rv-hover-icon-modal-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  min-width: 0;\n  gap: 2px;\n}\n\n.rv-hover-icon-modal-content-primary {\n  font-size: var(--hover-modal-item-size);\n  color: var(--hover-modal-item-color);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.rv-hover-icon-modal-content-secondary {\n  font-size: var(--hover-modal-meta-size);\n  color: var(--hover-modal-meta-color);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* Loading/Empty States */\n.rv-hover-icon-modal-loading,\n.rv-hover-icon-modal-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 48px 24px;\n  color: var(--text-dim);\n  font-size: 13px;\n}\n\n.rv-hover-icon-modal-empty .material-symbols-outlined {\n  font-size: 32px;\n  opacity: 0.5;\n}\n\n/* Keyboard Hint */\n.rv-hover-icon-modal-hint {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px;\n  border-top: 1px solid var(--hover-modal-header-border);\n  font-size: var(--hover-modal-hint-size);\n  color: var(--hover-modal-hint-color);\n  flex-shrink: 0;\n}\n\n.rv-hover-icon-modal-hint .material-symbols-outlined {\n  font-size: 14px;\n}\n\n/* Preview Popover */\n.rv-hover-icon-modal-preview {\n  position: fixed;\n  left: var(--modal-left);\n  top: var(--modal-top);\n  width: var(--hover-modal-preview-width);\n  max-height: var(--hover-modal-preview-max-height);\n  background: var(--hover-modal-bg);\n  border: 1px solid var(--hover-modal-border);\n  border-radius: 8px;\n  box-shadow: var(--hover-modal-shadow);\n  z-index: var(--z-tooltip, 1004);\n  overflow: hidden;\n  animation: hover-modal-preview-fade 150ms ease;\n}\n\n@keyframes hover-modal-preview-fade {\n  from {\n    opacity: 0;\n    transform: translateX(-8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n.rv-hover-icon-modal-preview img {\n  width: 100%;\n  height: auto;\n  max-height: 260px;\n  object-fit: contain;\n  display: block;\n  background: var(--panel-bg);\n}\n\n.rv-hover-icon-modal-preview-label {\n  padding: 8px 12px;\n  font-size: 12px;\n  color: var(--text-dim);\n  border-top: 1px solid var(--hover-modal-border);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* Trigger button base */\n.rv-hover-icon-trigger {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  padding: 0;\n  background: transparent;\n  border: none;\n  border-radius: 4px;\n  color: var(--chrome-accent, var(--text-dim));\n  cursor: pointer;\n  transition: opacity 0.15s, background 0.15s;\n}\n\n.rv-hover-icon-trigger:hover {\n  opacity: 0.8;\n  background: var(--neutral-chrome-bg);\n}\n\n.rv-hover-icon-trigger.open {\n  opacity: 1;\n  background: var(--neutral-chrome-bg);\n}\n\n.rv-hover-icon-trigger .material-symbols-outlined {\n  font-size: 18px;\n}\n/**\n * Voice Recorder - K.I.T.T. Style Visualizer\n * Ring IS the timer + three vertical stripes in center for voice\n */\n\n.rv-voice-recorder {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--space-md, 12px);\n  padding: var(--space-lg, 16px);\n  min-width: 200px;\n}\n\n.rv-mic-trigger-wrap {\n  position: relative;\n  display: inline-flex;\n}\n\n/* Header */\n.rv-voice-recorder__header {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  width: 100%;\n}\n\n.rv-voice-recorder__title {\n  margin: 0;\n  font-size: var(--font-md, 13px);\n  font-weight: 500;\n  color: var(--text-dim);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n/* Ring container - ring is the timer, bars in center */\n.rv-voice-recorder__ring-container {\n  position: relative;\n  width: 140px;\n  height: 140px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Progress ring - THIS is the timer */\n.rv-voice-recorder__ring {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 140px;\n  height: 140px;\n  transform: rotate(-90deg);\n}\n\n.rv-voice-recorder__ring-bg {\n  fill: none;\n  stroke: var(--neutral-chrome-bg, #3a3a3a);\n  stroke-width: 4;\n}\n\n.rv-voice-recorder__ring-fill {\n  fill: none;\n  stroke: var(--theme-primary, #39628e);\n  stroke-width: 4;\n  stroke-linecap: round;\n}\n\n/* K.I.T.T. Visualizer - Three vertical stripes IN THE CENTER */\n.rv-voice-recorder__kitt {\n  position: relative;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  gap: var(--space-xs, 4px);\n  height: 44px;\n  z-index: var(--z-content, 1);\n}\n\n.rv-voice-recorder__kitt-bar {\n  width: 8px;\n  background: var(--theme-primary, #39628e);\n  border-radius: var(--radius-sm, 2px);\n  transition: height 0.05s ease-out;\n  min-height: 4px;\n  height: var(--kitt-h, 4px);\n}\n\n/* Content area for other states */\n.rv-voice-recorder__content {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--space-md, 12px);\n  width: 100%;\n  padding: var(--space-lg, 16px) 0;\n}\n\n/* Grant button */\n.rv-voice-recorder__grant-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: var(--space-sm, 8px) var(--space-lg, 16px);\n  background: var(--neutral-chrome-bg);\n  border: 1px solid var(--neutral-chrome-border);\n  border-radius: var(--radius-md, 4px);\n  color: var(--text-secondary);\n  font-size: var(--font-sm, 12px);\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.rv-voice-recorder__grant-btn:hover {\n  background: var(--hover-modal-row-hover-bg);\n  color: var(--text-primary);\n}\n\n/* Cancel link */\n.rv-voice-recorder__cancel-link {\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  background: transparent;\n  border: none;\n  color: var(--text-dim);\n  font-size: var(--font-xs, 11px);\n  cursor: pointer;\n  transition: color 0.15s ease;\n}\n\n.rv-voice-recorder__cancel-link:hover {\n  color: var(--text-secondary);\n}\n\n/* Error state */\n.rv-voice-recorder__error {\n  color: var(--text-error, #ff4444);\n  font-size: var(--font-sm, 12px);\n  text-align: center;\n  margin: 0;\n}\n\n/* Spinner */\n.rv-voice-recorder__spinner {\n  width: 24px;\n  height: 24px;\n  border: 2px solid var(--neutral-chrome-border);\n  border-top-color: var(--text-secondary);\n  border-radius: 50%;\n  animation: spinner 0.8s linear infinite;\n}\n\n@keyframes spinner {\n  to { transform: rotate(360deg); }\n}\n\n/* Footer buttons */\n.rv-voice-recorder__footer {\n  display: flex;\n  gap: var(--space-sm, 8px);\n  width: 100%;\n  justify-content: center;\n}\n\n.rv-voice-recorder__btn {\n  padding: 6px var(--space-md, 12px);\n  border: 1px solid var(--neutral-chrome-border);\n  border-radius: var(--radius-md, 4px);\n  font-size: var(--font-sm, 12px);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.rv-voice-recorder__btn--secondary {\n  background: transparent;\n  color: var(--text-dim);\n}\n\n.rv-voice-recorder__btn--secondary:hover {\n  background: var(--neutral-chrome-bg);\n  color: var(--text-secondary);\n}\n\n.rv-voice-recorder__btn--primary {\n  background: var(--neutral-chrome-bg);\n  color: var(--text-secondary);\n}\n\n.rv-voice-recorder__btn--primary:hover {\n  background: var(--hover-modal-row-hover-bg);\n  color: var(--text-primary);\n}\n\n/* Hint text */\n.rv-voice-recorder__hint {\n  font-size: var(--font-xs, 11px);\n  color: var(--text-dim);\n  text-align: center;\n}\n\n/* Status messages in checking/processing/permission states */\n.rv-voice-recorder__status-text {\n  font-size: var(--font-sm, 12px);\n  color: var(--text-secondary);\n  text-align: center;\n  margin: 0;\n}\n\n/* Large icon in permission/error states */\n.rv-voice-recorder__icon-lg {\n  font-size: var(--font-2xl, 32px);\n  color: var(--text-dim);\n}\n\n.rv-voice-recorder__icon-lg--error {\n  font-size: var(--font-2xl, 32px);\n  color: var(--text-error, #ff4444);\n}\n\n/* Small icon inside action buttons */\n.rv-voice-recorder__grant-btn .material-symbols-outlined,\n.rv-voice-recorder__btn .material-symbols-outlined {\n  font-size: var(--font-lg, 16px);\n}\n\n.rv-voice-recorder__hint kbd {\n  display: inline-block;\n  padding: 1px var(--space-xs, 4px);\n  background: var(--neutral-chrome-bg);\n  border: 1px solid var(--neutral-chrome-border);\n  border-radius: 3px;\n  font-family: var(--font-mono, monospace);\n  font-size: var(--font-2xs, 10px);\n}\n\n.rv-mic-context-menu {\n  position: fixed;\n  z-index: var(--z-popover, 320);\n  width: min(210px, calc(100vw - var(--space-lg, 24px)));\n  padding: var(--space-xs, 4px);\n  border: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.18));\n  border-radius: var(--radius-md, 10px);\n  background: var(--panel-chrome-bg, #1a1a1a);\n  box-shadow: var(--shadow-medium, 0 12px 32px rgba(0, 0, 0, 0.42));\n  color: var(--text-primary, #ffffff);\n}\n\n.rv-mic-context-action {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n  width: 100%;\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  border: none;\n  border-radius: var(--radius-sm, 7px);\n  background: transparent;\n  color: var(--text-primary, #ffffff);\n  cursor: pointer;\n  font: inherit;\n  font-size: var(--font-size-sm, 13px);\n  text-align: left;\n}\n\n.rv-mic-context-action:hover {\n  background: rgba(var(--theme-primary-rgb), 0.12);\n  color: var(--theme-primary, currentColor);\n}\n\n.rv-mic-context-action .material-symbols-outlined {\n  color: var(--chrome-accent, var(--theme-primary));\n  font-size: var(--icon-size-sm, 18px);\n}\n\n.rv-mic-prompt-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: var(--z-modal, 1200);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-xl, 32px);\n  background: var(--overlay-lg, rgba(0, 0, 0, 0.72));\n}\n\n.rv-mic-prompt-dialog {\n  display: flex;\n  flex-direction: column;\n  width: min(50vw, 760px);\n  max-width: calc(100vw - var(--space-2xl, 64px));\n  max-height: calc(100vh - var(--space-2xl, 64px));\n  border: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.18));\n  border-radius: var(--radius-lg, 14px);\n  background: var(--panel-chrome-bg, #151515);\n  box-shadow: var(--shadow-strong, 0 24px 80px rgba(0, 0, 0, 0.62));\n  color: var(--text-primary, #ffffff);\n  overflow: hidden;\n}\n\n.rv-mic-prompt-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-md, 12px);\n  padding: var(--space-lg, 18px) var(--space-xl, 24px);\n  border-bottom: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n}\n\n.rv-mic-prompt-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n  margin-left: auto;\n}\n\n.rv-mic-prompt-action {\n  min-height: 32px;\n  padding: 0 var(--space-md, 12px);\n  border: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.14));\n  border-radius: var(--radius-sm, 8px);\n  background: transparent;\n  color: var(--text-secondary, rgba(255, 255, 255, 0.78));\n  cursor: pointer;\n  font: inherit;\n  font-size: var(--font-size-sm, 13px);\n}\n\n.rv-mic-prompt-action:hover:not(:disabled) {\n  background: rgba(var(--theme-primary-rgb), 0.12);\n  color: var(--theme-primary, currentColor);\n}\n\n.rv-mic-prompt-action:disabled {\n  cursor: default;\n  opacity: 0.45;\n}\n\n.rv-mic-prompt-action--primary {\n  border-color: var(--theme-primary, rgba(255, 255, 255, 0.25));\n  color: var(--theme-primary, currentColor);\n}\n\n.rv-mic-prompt-saved {\n  color: var(--text-dim, rgba(255, 255, 255, 0.58));\n  font-size: var(--font-size-sm, 13px);\n}\n\n.rv-mic-prompt-header h2,\n.rv-mic-prompt-header p {\n  margin: 0;\n}\n\n.rv-mic-prompt-header h2 {\n  font-size: var(--font-size-lg, 18px);\n  font-weight: 600;\n}\n\n.rv-mic-prompt-header p {\n  margin-top: var(--space-xs, 4px);\n  color: var(--text-dim, rgba(255, 255, 255, 0.58));\n  font-size: var(--font-size-sm, 13px);\n}\n\n.rv-mic-prompt-close {\n  display: grid;\n  place-items: center;\n  width: 32px;\n  height: 32px;\n  border: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.14));\n  border-radius: var(--radius-sm, 8px);\n  background: transparent;\n  color: var(--text-secondary, rgba(255, 255, 255, 0.78));\n  cursor: pointer;\n}\n\n.rv-mic-prompt-close:hover {\n  background: rgba(var(--theme-primary-rgb), 0.12);\n  color: var(--theme-primary, currentColor);\n}\n\n.rv-mic-prompt-body {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  padding: 0;\n  overflow: hidden;\n}\n\n.rv-mic-prompt-editor {\n  flex: 1;\n  min-height: 360px;\n  max-height: calc(100vh - 210px);\n}\n\n.rv-mic-prompt-gutter {\n  overflow: hidden;\n}\n\n.rv-mic-prompt-textarea {\n  flex: 1;\n  min-width: 0;\n  padding: 12px 16px;\n  border: none;\n  outline: none;\n  resize: none;\n  background: var(--document-bg, #161616);\n  color: var(--hljs-base, var(--text-primary, #e0e0e0));\n  font: inherit;\n  line-height: 1.6;\n  tab-size: 2;\n  white-space: pre;\n  overflow: auto;\n}\n\n.rv-mic-prompt-status,\n.rv-mic-prompt-error {\n  padding: var(--space-md, 12px) var(--space-lg, 16px);\n  border-bottom: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  color: var(--text-secondary, rgba(255, 255, 255, 0.78));\n  font-size: var(--font-size-md, 14px);\n}\n\n.rv-mic-prompt-error {\n  color: var(--text-error, #ff6666);\n}\n\n@media (max-width: 760px) {\n  .rv-mic-prompt-dialog {\n    width: calc(100vw - var(--space-xl, 32px));\n    max-width: calc(100vw - var(--space-xl, 32px));\n  }\n\n  .rv-mic-prompt-header {\n    flex-wrap: wrap;\n  }\n\n  .rv-mic-prompt-actions {\n    order: 3;\n    width: 100%;\n    justify-content: flex-end;\n  }\n}\n.rv-screenshot-flash-overlay {\n  position: fixed;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: var(--overlay-md, rgba(0, 0, 0, 0.5));\n  z-index: var(--z-system, 10000);\n  opacity: 1;\n  transition: opacity var(--transition-fast, 200ms) ease-out;\n  pointer-events: none;\n}\n\n.rv-screenshot-flash-overlay--fade {\n  opacity: 0;\n}\n\n.rv-screenshot-flash-image {\n  display: block;\n  width: calc(var(--space-xl, 24px) * 10);\n  height: auto;\n  max-height: calc(var(--space-xl, 24px) * 7.5);\n  object-fit: contain;\n  transform: scale(var(--flash-scale, 1));\n  transform-origin: center center;\n  transition: transform var(--transition-normal, 500ms) ease-out;\n  box-shadow: var(--shadow-medium, 0 12px 32px rgba(0, 0, 0, 0.42));\n  border-radius: var(--radius-md, 4px);\n}\n\n.rv-screenshot-flash-overlay--thumbnail .rv-screenshot-flash-image,\n.rv-screenshot-flash-overlay--fade .rv-screenshot-flash-image {\n  transform: scale(1);\n}\n/*\n * Clipboard popup row affordances.\n *\n * The popup itself uses .rv-hover-icon-modal-* classes from\n * components/hover-icon-modal/HoverIconModal.css. This file styles only\n * the clipboard-specific additions: the leading lock icon for secret\n * rows and the trailing trash button for per-row delete.\n */\n\n.rv-clipboard-row-icon {\n  flex-shrink: 0;\n  font-size: 16px;\n  color: var(--text-secondary, #888);\n  font-variation-settings: 'FILL' 1;\n}\n\n.rv-clipboard-row-delete {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  margin: 0;\n  padding: 0;\n  border: none;\n  border-radius: 4px;\n  background: transparent;\n  color: var(--text-secondary, #888);\n  cursor: pointer;\n  opacity: 0;\n  transition: opacity 0.15s ease, background-color 0.15s ease, color 0.15s ease;\n}\n\n.rv-hover-icon-modal-row:hover .rv-clipboard-row-delete,\n.rv-hover-icon-modal-row.selected .rv-clipboard-row-delete,\n.rv-clipboard-row-delete:focus-visible {\n  opacity: 1;\n}\n\n.rv-clipboard-row-delete:hover {\n  background: var(--neutral-chrome-bg, rgba(255, 255, 255, 0.08));\n  color: var(--danger-color, #e57373);\n}\n\n.rv-clipboard-row-delete:focus-visible {\n  outline: 2px solid var(--accent-color, #ff6b35);\n  outline-offset: 1px;\n}\n\n.rv-clipboard-row-delete:active {\n  transform: scale(0.95);\n}\n\n.rv-clipboard-row-delete .material-symbols-outlined {\n  font-size: 18px;\n  line-height: 1;\n}\n/* Shared dropdown base — used by chat-header dropdowns, harness picker, thread list */\n\n/* Menu-item icons (shared across rv-dropdown and rv-thread-menu-dropdown).\n * Default Material Symbols are 24px; size them down so they read inline\n * with the 12–13px text. */\n.rv-dropdown-item .material-symbols-outlined {\n  font-size: 18px;\n  flex-shrink: 0;\n  opacity: 0.85;\n}\n\n.rv-dropdown {\n  position: absolute;\n  width: 240px;\n  background: var(--sidebar-surface-bg, #161616);\n  border: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  border-radius: var(--radius-md, 4px);\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);\n  z-index: var(--z-overlay, 1000);\n  max-height: min(60vh, 400px);\n  overflow-y: auto;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 150ms ease;\n  padding: var(--space-2xs, 2px) 0;\n}\n\n.rv-dropdown[data-open=\"true\"] {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.rv-dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n  width: 100%;\n  padding: var(--space-sm, 8px) var(--space-md, 12px);\n  background: transparent;\n  border: none;\n  /* Menu items follow the picker's \"Chrome settings\" sliders via --chrome-accent. */\n  color: var(--chrome-accent, var(--text-dim));\n  font-size: var(--font-sm, 12px);\n  text-align: left;\n  cursor: pointer;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.rv-dropdown-item:hover:not([disabled]) {\n  background: var(--glass-sm, rgba(255, 255, 255, 0.06));\n}\n\n.rv-dropdown-item[aria-current=\"true\"] {\n  background: rgba(var(--theme-primary-rgb, 57, 98, 142), 0.12);\n  color: var(--theme-primary, #39628e);\n}\n\n/* Disabled menu items keep the same color as enabled — only the action and\n   cursor change. */\n.rv-dropdown-item[disabled] {\n  cursor: default;\n}\n\n.rv-dropdown-item-badge {\n  margin-left: auto;\n  font-size: var(--font-2xs, 10px);\n  color: var(--text-dim, rgba(255, 255, 255, 0.6));\n}\n\n.rv-dropdown-empty {\n  padding: var(--space-sm, 8px) var(--space-md, 12px);\n  color: var(--text-dim, rgba(255, 255, 255, 0.6));\n  font-size: var(--font-sm, 12px);\n}\n/* CLI Picker Dropdown — position + per-row CLI accent overrides */\n\n.rv-cli-picker-dropdown {\n  top: calc(var(--chat-header-height, 40px) - 4px);\n  /* Anchored under the edit_square button beside the collapsed thread dock. */\n  right: auto;\n  left: calc(var(--space-xs, 4px) + 28px + var(--space-xs, 4px));\n}\n\n/* Each row carries its CLI's accent as \\`--cli-accent\\`.\n * Icon colors + hover tint pick that up so rows feel identifiably themed. */\n.rv-cli-picker-dropdown .rv-dropdown-item .material-symbols-outlined {\n  color: var(--cli-accent, var(--text-primary));\n  font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n}\n\n.rv-cli-picker-dropdown .rv-dropdown-item:hover:not([disabled]) {\n  background: color-mix(in srgb, var(--cli-accent, #ffffff) 10%, transparent);\n}\n\n/* Model submenu — back row, provider groups, active model, chevron. */\n\n.rv-cli-picker-back {\n  border-bottom: 1px solid var(--border-subtle, rgba(128, 128, 128, 0.25));\n  margin-bottom: var(--space-xs, 4px);\n}\n\n.rv-cli-picker-back .material-symbols-outlined {\n  color: var(--text-secondary);\n}\n\n.rv-cli-picker-chevron {\n  margin-left: auto;\n  font-size: 16px;\n  color: var(--text-secondary);\n}\n\n.rv-cli-picker-group {\n  padding-bottom: var(--space-xs, 4px);\n}\n\n.rv-cli-picker-group-label {\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: var(--text-secondary, inherit);\n}\n\n.rv-cli-picker-model-name {\n  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);\n  font-size: 12px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.rv-dropdown-item-active {\n  background: color-mix(in srgb, var(--cli-accent, #ffffff) 12%, transparent);\n}\n/* ── ToolCallBlock — collapsible tool segment shell ────────────────────── */\n\n.rv-tool-header-btn {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n  padding: var(--space-xs, 4px) 0;\n  border: none;\n  background: none;\n  cursor: default;\n  color: var(--tool-label-color, var(--text-dim));\n  font: inherit;\n  opacity: 1;\n}\n\n.rv-tool-header-btn[data-interactive=\"true\"] {\n  cursor: pointer;\n}\n\n.rv-tool-icon {\n  font-size: var(--tool-icon-size, 16px);\n  color: var(--tool-icon-color, currentColor);\n}\n\n.rv-tool-label {\n  font-size: 13px;\n  font-style: var(--tool-label-style, normal);\n}\n\n.rv-tool-arrow-icon {\n  font-size: 16px;\n  vertical-align: middle;\n  margin-left: 2px;\n  transform: rotate(-90deg);\n  transition: transform var(--tool-collapse-ms, 300ms) ease;\n}\n\n.rv-tool-header-btn[data-expanded=\"true\"] .rv-tool-arrow-icon {\n  transform: rotate(0deg);\n}\n\n.rv-tool-content-area {\n  margin-left: var(--space-xl, 24px);\n  overflow: hidden;\n  max-height: 0;\n  opacity: 0;\n  transition:\n    max-height var(--tool-collapse-ms, 300ms) ease,\n    opacity var(--tool-collapse-ms, 300ms) ease;\n  border-left: var(--tool-border-w, 0px) solid var(--tool-border-color, transparent);\n  padding-left: var(--tool-border-pl, 0px);\n}\n\n.rv-tool-content-area[data-expanded=\"true\"] {\n  max-height: 2000px;\n  opacity: 1;\n}\n\n.rv-tool-content-body {\n  padding: var(--space-sm, 8px) 0;\n  font-size: 13px;\n  color: var(--tool-content-color, var(--text-dim));\n}\n\n.rv-shell-command {\n  color: var(--chat-tools-color, currentColor);\n}\n\n.rv-tool-error {\n  display: grid;\n  gap: var(--space-xs, 4px);\n}\n\n.rv-tool-error-title {\n  color: var(--error, #ef4444);\n  font-weight: 600;\n}\n\n.rv-tool-error-context {\n  color: var(--text-dim, currentColor);\n}\n\n.rv-tool-error-context-label {\n  color: var(--text-muted, var(--text-dim, currentColor));\n}\n\n.rv-tool-error-status,\n.rv-tool-error-output {\n  color: var(--error, #ef4444);\n  opacity: 0.88;\n}\n\n.rv-tool-error-output {\n  margin: 0;\n  white-space: pre-wrap;\n  font: inherit;\n}\n\n/* ── ToolsPanel — left-rail workspace/tool switcher ─────────────────────── */\n\n.rv-tools-panel {\n  --interactive-surface-bg: var(--panel-chrome-bg, #1a1a1a);\n  grid-column: 1 / 2;\n  grid-row: 2;\n  background: var(--panel-chrome-bg, #1a1a1a);\n  border-right: 1px solid var(--workspace-border-color, var(--neutral-chrome-border, rgba(255, 255, 255, 0.12)));\n  display: flex;\n  flex-direction: column;\n  padding: 8px 0;\n  gap: 4px;\n}\n\n.rv-tool-btn {\n  width: 40px;\n  height: 40px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: transparent;\n  border: none;\n  color: var(--workspace-foreground-color, var(--chrome-accent, var(--text-dim)));\n  cursor: pointer;\n  position: relative;\n}\n\n.rv-tool-btn .material-symbols-outlined {\n  font-size: var(--navigation-rail-icon-size, 24px);\n}\n\n.rv-tool-btn:hover:not(.active),\n.rv-tool-btn:active:not(.active) {\n  color: var(--interactive-contrast-foreground, #ffffff);\n  background: transparent;\n}\n\n.rv-tool-btn:focus-visible {\n  outline: 2px solid var(--interactive-focus-ring, var(--interactive-contrast-foreground, #ffffff));\n  outline-offset: -3px;\n}\n\n.rv-tool-btn.active {\n  color: var(--workspace-accent-color, var(--accent-dim, var(--theme-primary)));\n}\n\n.rv-tool-btn.active::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 3px;\n  height: 24px;\n  background: var(--workspace-accent-color, var(--accent-dim, var(--theme-primary)));\n  border-radius: 0 2px 2px 0;\n}\n\n/* App-mode two-zone layout with divider */\n.rv-tools-panel--app {\n  gap: 0;\n}\n\n.rv-tools-apps {\n  display: flex;\n  flex-direction: column;\n  padding: 8px 0;\n  gap: 8px;\n}\n\n.rv-tools-divider {\n  border: none;\n  border-top: 1px solid var(--workspace-border-color, var(--neutral-chrome-border, rgba(255, 255, 255, 0.25)));\n  margin: 8px 16px;\n}\n\n.rv-tools-tools {\n  display: flex;\n  flex-direction: column;\n  padding: 8px 0;\n  gap: 8px;\n}\n\n.rv-tool-btn--app {\n  height: 40px;\n}\n\n.rv-tool-btn--tool {\n  height: 40px;\n}\n\n.rv-view-context-menu {\n  position: fixed;\n  z-index: var(--z-popover, 320);\n  width: min(240px, calc(100vw - var(--space-lg, 24px)));\n  padding: var(--space-sm, 8px);\n  border: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.18));\n  border-radius: var(--radius-md, 10px);\n  background: var(--panel-chrome-bg, #1a1a1a);\n  box-shadow: var(--shadow-medium, 0 12px 32px rgba(0, 0, 0, 0.42));\n  color: var(--text-primary, #ffffff);\n}\n\n.rv-view-context-heading {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n  padding: var(--space-xs, 4px) var(--space-xs, 4px) var(--space-sm, 8px);\n  border-bottom: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  margin-bottom: var(--space-xs, 4px);\n}\n\n.rv-view-context-icon {\n  color: var(--chrome-accent, var(--theme-primary));\n  font-size: var(--icon-size-md, 22px);\n}\n\n.rv-view-context-title-group {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.rv-view-context-title,\n.rv-view-context-id {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.rv-view-context-title {\n  font-size: var(--font-size-sm, 13px);\n  color: var(--text-primary, #ffffff);\n}\n\n.rv-view-context-id {\n  font-size: var(--font-size-xs, 11px);\n  color: var(--text-dim, rgba(255, 255, 255, 0.58));\n}\n\n.rv-view-context-action,\n.rv-view-context-save {\n  width: 100%;\n  border: none;\n  border-radius: var(--radius-sm, 7px);\n  background: transparent;\n  color: var(--text-primary, #ffffff);\n  cursor: pointer;\n  font: inherit;\n  font-size: var(--font-size-sm, 13px);\n  text-align: left;\n}\n\n.rv-view-context-action {\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n}\n\n.rv-view-context-action--with-icon {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n}\n\n.rv-view-context-action-icon {\n  color: var(--chrome-accent, var(--theme-primary));\n  font-size: var(--icon-size-sm, 18px);\n}\n\n.rv-view-context-action:hover:not(:disabled),\n.rv-view-context-save:hover:not(:disabled) {\n  background: rgba(var(--theme-primary-rgb), 0.12);\n  color: var(--theme-primary, currentColor);\n}\n\n.rv-view-context-action:disabled,\n.rv-view-context-save:disabled {\n  cursor: not-allowed;\n  color: var(--text-muted, rgba(255, 255, 255, 0.32));\n}\n\n.rv-view-context-action--danger:not(:disabled) {\n  color: var(--error, #ef4444);\n}\n\n.rv-view-context-form {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs, 4px);\n  padding: var(--space-sm, 8px) var(--space-xs, 4px);\n}\n\n.rv-view-context-label {\n  font-size: var(--font-size-xs, 11px);\n  color: var(--text-dim, rgba(255, 255, 255, 0.58));\n}\n\n.rv-view-context-input {\n  width: 100%;\n  box-sizing: border-box;\n  border: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.18));\n  border-radius: var(--radius-sm, 7px);\n  background: var(--bg-surface, rgba(255, 255, 255, 0.06));\n  color: var(--text-primary, #ffffff);\n  font: inherit;\n  font-size: var(--font-size-sm, 13px);\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n}\n\n.rv-view-context-input:focus {\n  outline: none;\n  border-color: var(--theme-primary, currentColor);\n}\n\n.rv-view-context-save {\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  background: rgba(var(--theme-primary-rgb), 0.08);\n}\n\n.rv-view-context-section {\n  padding: var(--space-xs, 4px) 0;\n}\n\n.rv-view-context-section + .rv-view-context-section {\n  border-top: 1px solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  margin-top: var(--space-xs, 4px);\n  padding-top: var(--space-sm, 8px);\n}\n\n.rv-view-context-section-title {\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  color: var(--text-dim, rgba(255, 255, 255, 0.58));\n  font-size: var(--font-size-xs, 11px);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.rv-view-context-empty {\n  padding: var(--space-sm, 8px);\n  color: var(--text-dim, rgba(255, 255, 255, 0.58));\n  font-size: var(--font-size-sm, 13px);\n}\n\n.rv-view-context-error {\n  margin-top: var(--space-xs, 4px);\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  border-radius: var(--radius-sm, 7px);\n  background: var(--error-bg, rgba(239, 68, 68, 0.12));\n  color: var(--error, #ef4444);\n  font-size: var(--font-size-xs, 11px);\n}\n/* AI Thinking Orb - Pulsating cursor effect */\n@keyframes thinking-pulse {\n  0%, 100% { \n    opacity: 0.4; \n    transform: scale(0.8);\n    filter: blur(0px);\n  }\n  50% { \n    opacity: 1; \n    transform: scale(1.2);\n    filter: blur(2px);\n  }\n}\n\n/* User bubble fade-in: 0 → 1 over 200ms. Applied on new user messages. */\n@keyframes user-bubble-in {\n  0%   { opacity: 0; }\n  100% { opacity: 1; }\n}\n\n.rv-user-bubble-in {\n  animation: user-bubble-in 200ms ease-out forwards;\n}\n\n/* Tool block fade-in: 0 → 1 over 200ms. Applied on mount. */\n@keyframes tool-fade-in {\n  0%   { opacity: 0; }\n  100% { opacity: 1; }\n}\n\n.rv-tool-fade-in {\n  animation: tool-fade-in 200ms ease-in forwards;\n  margin-bottom: var(--space-md, 12px);\n}\n\n/* Shimmer for thinking */\n@keyframes shimmer {\n  0% {\n    background-position: 200% 0;\n  }\n  100% {\n    background-position: -200% 0;\n  }\n}\n\n/*\n * Blur sphere — three-phase animation:\n *   1. Expand: 0.3 → 1.0 scale over 1.5s (with 500ms initial delay)\n *   2. Breathe: pulse between 1.0 and 0.7 scale indefinitely (handles API latency)\n *   3. Dispose: collapse from current state to 0.3 scale over 500ms\n *\n * The expand animation runs once, then the breathe loop takes over.\n * Disposal is triggered by adding the .disposing class.\n */\n@keyframes blur-sphere-expand {\n  0%   { opacity: 0; transform: scale(0.3); }\n  100% { opacity: 1; transform: scale(1); }\n}\n\n@keyframes blur-sphere-breathe {\n  0%   { opacity: 1;   transform: scale(1); }\n  50%  { opacity: 0.6; transform: scale(0.7); }\n  100% { opacity: 1;   transform: scale(1); }\n}\n\n@keyframes blur-sphere-dispose {\n  0%   { opacity: 1; transform: scale(1); }\n  40%  { opacity: 1; transform: scale(0.5); }\n  100% { opacity: 0; transform: scale(0.3); }\n}\n\n.rv-blur-sphere {\n  display: inline-block;\n  opacity: 0;\n  transform: scale(0.3);\n  /* Expand first (1.5s + 500ms delay), then breathe loop takes over */\n  animation:\n    blur-sphere-expand 1500ms ease-out 500ms forwards,\n    blur-sphere-breathe 2000ms ease-in-out 2000ms infinite;\n}\n\n.rv-blur-sphere.disposing {\n  /* Override both animations — collapse from wherever we are */\n  animation: blur-sphere-dispose 500ms ease-in forwards;\n}\n\n/* Orb component wrapper and icon */\n.rv-orb-wrapper {\n  padding: var(--space-xs, 4px) 0;\n}\n\n.rv-orb-icon {\n  font-size: var(--font-lg, 16px);\n  color: var(--theme-primary);\n}\n\n.rv-shimmer-text {\n  background: linear-gradient(90deg,\n    var(--icon-dim, var(--text-dim)) 0%,\n    var(--accent-dim, var(--theme-primary)) 50%,\n    var(--icon-dim, var(--text-dim)) 100%\n  );\n  background-size: 200% 100%;\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  animation: shimmer 1500ms linear infinite;\n}\n.rv-hourglass-flow {\n  --hourglass-size: var(--tool-icon-size, 16px);\n  --hourglass-color: var(--tool-icon-color, var(--chat-tools-color, var(--text-dim)));\n  --hourglass-muted: var(--tool-label-color, var(--chat-tools-color, var(--text-dim)));\n  --hourglass-bg: var(--chat-surface-bg, var(--panel-chrome-bg, #1a1a1a));\n  --hourglass-font-size-sm: var(--font-size-xs, 12px);\n  --hourglass-font-size-md: var(--font-size-sm, 13px);\n  --hourglass-font-size-lg: var(--font-size-md, 14px);\n  --hourglass-line-height: var(--line-height-tight, 1.3);\n  --hourglass-size-sm: var(--icon-size-sm, 16px);\n  --hourglass-size-md: var(--icon-size-md, 18px);\n  --hourglass-size-lg: var(--icon-size-lg, 22px);\n  --hourglass-z-bottom: var(--z-base, 1);\n  --hourglass-z-overlay: var(--z-content, 2);\n  --hourglass-z-top: var(--z-content, 1);\n  --hourglass-z-stream: var(--z-popover, 4);\n  --hourglass-animation-duration: var(--hourglass-cycle-duration, 15s);\n  --hourglass-reduced-motion-duration: var(--transition-none, 1ms);\n  --hourglass-stream-top: 39%;\n  --hourglass-stream-width: max(1px, calc(var(--hourglass-size) * 0.07));\n  --hourglass-stream-height: calc(var(--hourglass-size) * 0.22);\n  --hourglass-stream-radius: var(--radius-pill, 999px);\n  --hourglass-stream-opacity: var(--opacity-strong, 0.85);\n  --hourglass-icon-fill: 1;\n  --hourglass-icon-weight: 400;\n  --hourglass-icon-grade: 0;\n  --hourglass-icon-optical-size: 24;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n  color: var(--tool-label-color, var(--chat-tools-color, var(--text-dim)));\n  font-size: var(--hourglass-font-size-md);\n  line-height: var(--hourglass-line-height);\n}\n\n.rv-hourglass-flow--sm {\n  --hourglass-size: var(--hourglass-size-sm);\n  font-size: var(--hourglass-font-size-sm);\n}\n\n.rv-hourglass-flow--md {\n  --hourglass-size: var(--hourglass-size-md);\n}\n\n.rv-hourglass-flow--lg {\n  --hourglass-size: var(--hourglass-size-lg);\n  font-size: var(--hourglass-font-size-lg);\n}\n\n.rv-hourglass-flow-icon {\n  position: relative;\n  display: inline-grid;\n  place-items: center;\n  width: var(--hourglass-size);\n  height: var(--hourglass-size);\n  flex: 0 0 auto;\n  isolation: isolate;\n  overflow: hidden;\n  transform-origin: 50% 50%;\n  animation: rv-hourglass-flip var(--hourglass-animation-duration) linear infinite;\n}\n\n.rv-hourglass-glyph {\n  grid-area: 1 / 1;\n  font-size: var(--hourglass-size);\n  line-height: 1;\n  color: var(--hourglass-color);\n  font-variation-settings:\n    'FILL' var(--hourglass-icon-fill),\n    'wght' var(--hourglass-icon-weight),\n    'GRAD' var(--hourglass-icon-grade),\n    'opsz' var(--hourglass-icon-optical-size);\n}\n\n.rv-hourglass-bottom {\n  z-index: var(--hourglass-z-bottom);\n}\n\n.rv-hourglass-top-layer {\n  grid-area: 1 / 1;\n  position: relative;\n  display: grid;\n  place-items: center;\n  z-index: var(--hourglass-z-overlay);\n  width: var(--hourglass-size);\n  height: var(--hourglass-size);\n  clip-path: inset(0 0 0 0);\n  animation: rv-hourglass-top-layer-empty var(--hourglass-animation-duration) linear infinite;\n}\n\n.rv-hourglass-top-backing {\n  grid-area: 1 / 1;\n  width: var(--hourglass-size);\n  height: var(--hourglass-size);\n  background: var(--hourglass-bg);\n}\n\n.rv-hourglass-top {\n  grid-area: 1 / 1;\n  z-index: var(--hourglass-z-top);\n}\n\n.rv-hourglass-stream {\n  position: absolute;\n  z-index: var(--hourglass-z-stream);\n  top: var(--hourglass-stream-top);\n  left: 50%;\n  width: var(--hourglass-stream-width);\n  height: var(--hourglass-stream-height);\n  border-radius: var(--hourglass-stream-radius);\n  background: var(--hourglass-muted);\n  transform: translateX(-50%);\n  opacity: 0;\n  animation: rv-hourglass-stream var(--hourglass-animation-duration) linear infinite;\n}\n\n.rv-hourglass-flow-label {\n  min-width: 0;\n}\n\n@keyframes rv-hourglass-top-layer-empty {\n  0%, 6.667% {\n    clip-path: inset(0 0 0 0);\n  }\n  26.667% {\n    clip-path: inset(21.43% 0 21.43% 0);\n  }\n  80%, 99.999% {\n    clip-path: inset(50% 0 50% 0);\n  }\n  100% {\n    clip-path: inset(0 0 0 0);\n  }\n}\n\n@keyframes rv-hourglass-stream {\n  0%, 6.667% {\n    opacity: 0;\n  }\n  9%, 78% {\n    opacity: var(--hourglass-stream-opacity);\n  }\n  80%, 100% {\n    opacity: 0;\n  }\n}\n\n@keyframes rv-hourglass-flip {\n  0%, 96.667% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(180deg);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .rv-hourglass-flow-icon,\n  .rv-hourglass-top-layer,\n  .rv-hourglass-stream {\n    animation-duration: var(--hourglass-reduced-motion-duration);\n    animation-iteration-count: 1;\n  }\n}\n/*\n * WorkingActivity — transient \"Working…\" row (RCC-0108 SPEC-05 Slice A).\n *\n * Visual vocabulary matches the existing tool rows / subagent waiting row:\n * small hourglass + muted label. Every value traces to a CSS variable with a\n * fallback; nothing is hardcoded (parent §4.3, project CSS rules).\n */\n.rv-working-activity {\n  --working-activity-color: var(--tool-label-color, var(--chat-tools-color, var(--text-dim)));\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm, 8px);\n  padding: var(--space-xs, 4px) 0;\n  margin-bottom: var(--space-md, 12px);\n  color: var(--working-activity-color);\n  font-size: var(--font-size-xs, 12px);\n}\n\n.rv-working-activity-seconds {\n  min-width: 0;\n  white-space: nowrap;\n}\n\n/*\n * Scoped reduced-motion extension (§4.10): the hourglass drain/flip cycle is\n * already honored by HourglassFlow.css; this only calms this row's own\n * motion-sensitive properties WITHOUT touching other HourglassFlow consumers.\n */\n@media (prefers-reduced-motion: reduce) {\n  .rv-working-activity,\n  .rv-working-activity-seconds {\n    animation: none;\n    transition: none;\n  }\n}\n.rv-subagent-waiting-segment {\n  --tool-icon-size: 16px;\n  --tool-icon-color: var(--chat-tools-color, var(--text-dim));\n  --tool-label-color: var(--chat-tools-color, var(--text-dim));\n  padding: var(--space-xs, 4px) 0;\n}\n/*\n * ChatTurnError — durable safe terminal error row (RCC-0108 SPEC-05 Slice B,\n * parent §4.13). Visual vocabulary matches the existing shared tool-error\n * presentation (ToolsPanel.css .rv-tool-error-*): red semibold title, muted\n * context, red pre-wrapped body on neutral chat chrome. Every value traces\n * to a CSS variable with a fallback; nothing is hardcoded.\n */\n.rv-chat-turn-error {\n  --turn-error-color: var(--error, #ef4444);\n  display: grid;\n  gap: var(--space-xs, 4px);\n  padding: var(--space-xs, 4px) 0;\n  margin: var(--space-xs, 4px) 0 var(--space-md, 12px);\n  font-size: var(--font-size-sm, 13px);\n}\n\n.rv-chat-turn-error-title {\n  color: var(--turn-error-color);\n  font-weight: var(--font-weight-semibold, 600);\n}\n\n/* Safe catalog code in muted context text (§4.13). */\n.rv-chat-turn-error-code {\n  color: var(--text-muted, var(--text-dim, currentColor));\n  font-size: var(--font-size-xs, 12px);\n}\n\n/* Compact, deduplicated safe message — same red/error treatment, pre-wrapped. */\n.rv-chat-turn-error-message {\n  color: var(--turn-error-color);\n  opacity: var(--opacity-high, 0.88);\n  margin: 0;\n  white-space: pre-wrap;\n  font: inherit;\n  overflow-wrap: anywhere;\n}\n/* Explicit, user-invoked diagnostic controls; always outside the error alert. */\n.rv-chat-diagnostic-details {\n  display: grid;\n  gap: var(--space-xs, 4px);\n  margin: var(--space-xs, 4px) 0 var(--space-md, 12px);\n  font-size: var(--font-size-xs, 12px);\n}\n\n.rv-chat-diagnostic-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-xs, 4px);\n}\n\n.rv-chat-diagnostic-actions button {\n  appearance: none;\n  border: var(--border-width, 1px) solid var(--border-subtle, currentColor);\n  border-radius: var(--radius-sm, 4px);\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  color: var(--text-secondary, currentColor);\n  background: var(--bg-secondary, transparent);\n  font: inherit;\n  cursor: pointer;\n}\n\n.rv-chat-diagnostic-actions button:hover:not(:disabled),\n.rv-chat-diagnostic-actions button:focus-visible:not(:disabled) {\n  color: var(--text-primary, currentColor);\n  background: var(--bg-hover, transparent);\n}\n\n.rv-chat-diagnostic-actions button:disabled {\n  cursor: default;\n  opacity: var(--opacity-disabled, 0.5);\n}\n\n.rv-chat-diagnostic-status {\n  color: var(--text-muted, var(--text-dim, currentColor));\n}\n\n.rv-chat-diagnostic-report {\n  max-height: var(--diagnostic-report-max-height, 320px);\n  overflow: auto;\n  margin: 0;\n  padding: var(--space-sm, 8px);\n  border: var(--border-width, 1px) solid var(--border-subtle, currentColor);\n  border-radius: var(--radius-sm, 4px);\n  color: var(--text-secondary, currentColor);\n  background: var(--bg-secondary, transparent);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font: var(--font-size-xs, 12px) / var(--line-height-body, 1.5) var(--font-mono, monospace);\n}\n.rv-assistant-reply-shell {\n  position: relative;\n  display: inline-flex;\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n.rv-assistant-reply-chrome {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2xs, 2px);\n  margin-top: var(--space-xs, 4px);\n  min-height: var(--reply-chrome-height, 24px);\n  color: var(--chat-foreground-color, var(--text-dim, currentColor));\n}\n\n.rv-assistant-reply-chrome--disabled {\n  opacity: var(--reply-chrome-disabled-opacity, 0.55);\n}\n\n.rv-assistant-reply-action {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--reply-chrome-action-size, 24px);\n  height: var(--reply-chrome-action-size, 24px);\n  padding: var(--space-2xs, 2px);\n  border: var(--reply-chrome-action-border-width, 1px) solid transparent;\n  border-radius: var(--radius-sm, 4px);\n  background: transparent;\n  color: var(--chat-foreground-color, var(--text-dim, currentColor));\n  cursor: pointer;\n  transition:\n    background-color var(--transition-fast, 150ms) var(--transition-ease, ease),\n    color var(--transition-fast, 150ms) var(--transition-ease, ease),\n    border-color var(--transition-fast, 150ms) var(--transition-ease, ease);\n}\n\n.rv-assistant-reply-action:hover:not(:disabled),\n.rv-assistant-reply-action:focus-visible:not(:disabled) {\n  border-color: var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  background: var(--glass-sm, rgba(255, 255, 255, 0.06));\n  color: var(--chat-foreground-color, var(--theme-primary, currentColor));\n  outline: none;\n}\n\n.rv-assistant-reply-action:disabled {\n  cursor: default;\n}\n\n.rv-assistant-reply-action .material-symbols-outlined {\n  font-size: var(--reply-chrome-icon-size, 17px);\n  line-height: var(--line-height-tight, 1);\n  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;\n}\n\n.rv-assistant-reply-action--filled .material-symbols-outlined {\n  font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;\n}\n\n.rv-assistant-reply-editor {\n  position: absolute;\n  top: calc(100% + var(--space-xs, 4px));\n  left: 0;\n  z-index: var(--z-overlay, 1000);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm, 8px);\n  width: min(var(--reply-chrome-editor-width, 320px), calc(100vw - var(--space-xl, 32px)));\n  padding: var(--space-md, 12px);\n  border: var(--reply-chrome-editor-border-width, 1px) solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  border-radius: var(--radius-md, 4px);\n  background: var(--neutral-chrome-bg, var(--sidebar-surface-bg, #161616));\n  box-shadow: var(--shadow-medium, 0 4px 16px rgba(0, 0, 0, 0.4));\n  color: var(--text-primary, currentColor);\n}\n\n.rv-assistant-reply-editor-header,\n.rv-assistant-reply-editor-footer,\n.rv-assistant-reply-editor-note-actions,\n.rv-assistant-reply-bookmark-options {\n  display: flex;\n  align-items: center;\n}\n\n.rv-assistant-reply-editor-header {\n  justify-content: space-between;\n  min-height: var(--reply-chrome-editor-header-height, 22px);\n}\n\n.rv-assistant-reply-editor-title {\n  color: var(--text-primary, currentColor);\n  font-size: var(--font-sm, 12px);\n  font-weight: var(--font-weight-medium, 500);\n  line-height: var(--line-height-tight, 1.2);\n}\n\n.rv-assistant-reply-bookmark-options {\n  gap: var(--space-xs, 4px);\n}\n\n.rv-assistant-reply-bookmark-option {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-xs, 4px);\n  min-height: var(--reply-chrome-bookmark-option-height, 28px);\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  border: var(--reply-chrome-action-border-width, 1px) solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  border-radius: var(--radius-sm, 4px);\n  background: transparent;\n  color: var(--chrome-accent, var(--text-dim, currentColor));\n  font-size: var(--font-sm, 12px);\n  line-height: var(--line-height-tight, 1.2);\n  cursor: pointer;\n  transition:\n    background-color var(--transition-fast, 150ms) var(--transition-ease, ease),\n    color var(--transition-fast, 150ms) var(--transition-ease, ease),\n    border-color var(--transition-fast, 150ms) var(--transition-ease, ease);\n}\n\n.rv-assistant-reply-bookmark-option:hover:not(:disabled),\n.rv-assistant-reply-bookmark-option:focus-visible:not(:disabled),\n.rv-assistant-reply-bookmark-option--selected {\n  border-color: var(--accent-dim, var(--theme-primary, currentColor));\n  background: var(--glass-sm, rgba(255, 255, 255, 0.06));\n  color: var(--text-primary, currentColor);\n  outline: none;\n}\n\n.rv-assistant-reply-bookmark-option .material-symbols-outlined {\n  font-size: var(--reply-chrome-editor-icon-size, 18px);\n  line-height: var(--line-height-tight, 1);\n  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;\n}\n\n.rv-assistant-reply-bookmark-option--selected .material-symbols-outlined {\n  font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;\n}\n\n.rv-assistant-reply-editor-note {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs, 4px);\n}\n\n.rv-assistant-reply-editor-textarea {\n  width: 100%;\n  min-height: var(--reply-chrome-note-min-height, 96px);\n  resize: vertical;\n  padding: var(--space-sm, 8px);\n  border: var(--reply-chrome-action-border-width, 1px) solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  border-radius: var(--radius-sm, 4px);\n  background: var(--glass-sm, rgba(255, 255, 255, 0.06));\n  color: var(--text-primary, currentColor);\n  font: inherit;\n  font-size: var(--font-sm, 12px);\n  line-height: var(--line-height-normal, 1.4);\n}\n\n.rv-assistant-reply-editor-textarea:focus {\n  border-color: var(--accent-dim, var(--theme-primary, currentColor));\n  outline: none;\n}\n\n.rv-assistant-reply-editor-textarea::placeholder {\n  color: var(--text-dim, currentColor);\n}\n\n.rv-assistant-reply-editor-note-actions {\n  gap: var(--space-2xs, 2px);\n}\n\n.rv-assistant-reply-editor-icon-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--reply-chrome-action-size, 24px);\n  height: var(--reply-chrome-action-size, 24px);\n  padding: var(--space-2xs, 2px);\n  border: var(--reply-chrome-action-border-width, 1px) solid transparent;\n  border-radius: var(--radius-sm, 4px);\n  background: transparent;\n  color: var(--chrome-accent, var(--text-dim, currentColor));\n  cursor: pointer;\n}\n\n.rv-assistant-reply-editor-icon-button:hover:not(:disabled),\n.rv-assistant-reply-editor-icon-button:focus-visible:not(:disabled) {\n  border-color: var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  background: var(--glass-sm, rgba(255, 255, 255, 0.06));\n  color: var(--accent-dim, var(--theme-primary, currentColor));\n  outline: none;\n}\n\n.rv-assistant-reply-editor-icon-button .material-symbols-outlined {\n  font-size: var(--reply-chrome-editor-icon-size, 18px);\n  line-height: var(--line-height-tight, 1);\n}\n\n.rv-assistant-reply-editor-footer {\n  justify-content: flex-end;\n  gap: var(--space-sm, 8px);\n}\n\n.rv-assistant-reply-editor-button {\n  min-height: var(--reply-chrome-editor-button-height, 28px);\n  padding: var(--space-xs, 4px) var(--space-md, 12px);\n  border: var(--reply-chrome-action-border-width, 1px) solid var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));\n  border-radius: var(--radius-sm, 4px);\n  background: transparent;\n  color: var(--text-primary, currentColor);\n  font-size: var(--font-sm, 12px);\n  cursor: pointer;\n}\n\n.rv-assistant-reply-editor-button:hover:not(:disabled),\n.rv-assistant-reply-editor-button:focus-visible:not(:disabled) {\n  background: var(--glass-sm, rgba(255, 255, 255, 0.06));\n  outline: none;\n}\n\n.rv-assistant-reply-editor-button--primary {\n  border-color: var(--accent-dim, var(--theme-primary, currentColor));\n  color: var(--accent-dim, var(--theme-primary, currentColor));\n}\n\n.rv-assistant-reply-editor-button:disabled,\n.rv-assistant-reply-editor-icon-button:disabled,\n.rv-assistant-reply-bookmark-option:disabled,\n.rv-assistant-reply-editor-textarea:disabled {\n  cursor: default;\n  opacity: var(--reply-chrome-disabled-opacity, 0.55);\n}\n/* ConnectingOverlay — same positioning as ChatHarnessPicker */\n\n.rv-connecting-overlay {\n  position: absolute;\n  inset: 0;\n  z-index: var(--z-content, 1);\n  background: var(--bg-primary, #111);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 20px;\n  animation: co-fade-in 0.15s ease;\n}\n\n@keyframes co-fade-in {\n  from { opacity: 0; }\n  to   { opacity: 1; }\n}\n\n.rv-co-spinner {\n  width: 40px;\n  height: 40px;\n  border: 3px solid var(--border-color, #2d2d2d);\n  border-top-color: var(--theme-primary, #a78bfa);\n  border-radius: 50%;\n  animation: co-spin 0.8s linear infinite;\n}\n\n@keyframes co-spin {\n  to { transform: rotate(360deg); }\n}\n\n.rv-co-label {\n  font-size: 13px;\n  color: var(--text-secondary, #888);\n}\n/* ── Todo Drawer ─────────────────────────────────────────────────────────── */\n\n.rv-todo-drawer {\n  --rv-todo-drawer-bg: var(--chrome-surface, var(--bg-surface, #1a1a1a));\n  --rv-todo-drawer-border: var(--border-color, rgba(255, 255, 255, 0.08));\n  --rv-todo-drawer-hover-bg: var(--hover-bg, rgba(255, 255, 255, 0.04));\n  --rv-todo-drawer-scroll-thumb: var(--border-color, rgba(255, 255, 255, 0.12));\n  --rv-todo-drawer-text: var(--text-primary, rgba(255, 255, 255, 0.85));\n  --rv-todo-drawer-muted: var(--text-dim, rgba(255, 255, 255, 0.6));\n  --rv-todo-drawer-accent: var(--theme-primary, #39628e);\n  --rv-todo-drawer-z: var(--z-chat-drawer, 2);\n  --rv-todo-drawer-shadow: var(--shadow-raised, 0 -4px 12px rgba(0, 0, 0, 0.25));\n  --rv-todo-drawer-transition-max: var(--transition-md, 200ms ease);\n  --rv-todo-drawer-transition-opacity: var(--transition-sm, 150ms ease);\n  --rv-todo-drawer-transition-hover: var(--transition-fast, 100ms ease);\n  --rv-todo-drawer-collapsed-height: var(--chat-todo-collapsed-height, 28px);\n  --rv-todo-drawer-expanded-height: var(--chat-todo-expanded-height, 280px);\n  --rv-todo-drawer-handle-gap: var(--space-sm, 8px);\n  --rv-todo-drawer-handle-padding-y: var(--space-2xs, 4px);\n  --rv-todo-drawer-handle-padding-x: var(--space-md, 12px);\n  --rv-todo-drawer-list-padding-bottom: var(--space-sm, 6px);\n  --rv-todo-drawer-item-gap: var(--space-xs, 6px);\n  --rv-todo-drawer-item-padding-y: var(--space-3xs, 3px);\n  --rv-todo-drawer-font-size: var(--font-size-xs, 12px);\n  --rv-todo-drawer-line-height: var(--line-height-sm, 18px);\n  --rv-todo-drawer-handle-line-height: var(--line-height-md, 20px);\n  --rv-todo-drawer-icon-size: var(--icon-size-sm, 16px);\n  --rv-todo-drawer-scrollbar-width: var(--scrollbar-width-sm, 4px);\n  --rv-todo-drawer-scrollbar-radius: var(--radius-xs, 2px);\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: var(--rv-todo-drawer-bg);\n  border-top: 1px solid var(--rv-todo-drawer-border);\n  display: flex;\n  flex-direction: column;\n  transition: max-height var(--rv-todo-drawer-transition-max), opacity var(--rv-todo-drawer-transition-opacity);\n  overflow: hidden;\n  z-index: var(--rv-todo-drawer-z);\n  box-shadow: var(--rv-todo-drawer-shadow);\n}\n\n/* ── Collapsed ribbon ── */\n.rv-todo-drawer--collapsed {\n  max-height: var(--rv-todo-drawer-collapsed-height);\n}\n\n/* ── Expanded overlay ── */\n.rv-todo-drawer--expanded {\n  max-height: var(--rv-todo-drawer-expanded-height);\n}\n\n/* ── Handle ── */\n.rv-todo-drawer-handle {\n  display: flex;\n  align-items: center;\n  gap: var(--rv-todo-drawer-handle-gap);\n  width: 100%;\n  padding: var(--rv-todo-drawer-handle-padding-y) var(--rv-todo-drawer-handle-padding-x);\n  background: transparent;\n  border: none;\n  cursor: pointer;\n  color: var(--rv-todo-drawer-muted);\n  font-size: var(--rv-todo-drawer-font-size);\n  line-height: var(--rv-todo-drawer-handle-line-height);\n  transition: background var(--rv-todo-drawer-transition-hover);\n  flex-shrink: 0;\n}\n\n.rv-todo-drawer-handle:hover {\n  background: var(--rv-todo-drawer-hover-bg);\n}\n\n.rv-todo-drawer-title {\n  font-weight: 600;\n  color: var(--rv-todo-drawer-text);\n  flex-shrink: 0;\n}\n\n.rv-todo-drawer-count {\n  flex: 1 1 auto;\n  text-align: left;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.rv-todo-drawer-arrow {\n  font-size: var(--rv-todo-drawer-icon-size);\n  flex-shrink: 0;\n  color: var(--accent-dim, var(--text-dim));\n}\n\n/* ── List ── */\n.rv-todo-drawer-list {\n  display: flex;\n  flex-direction: column;\n  flex: 1 1 auto;\n  min-height: 0;\n  padding: 0 var(--rv-todo-drawer-handle-padding-x) var(--rv-todo-drawer-list-padding-bottom);\n  overflow-y: auto;\n}\n\n/* ── Item ── */\n.rv-todo-drawer-item {\n  display: flex;\n  align-items: center;\n  gap: var(--rv-todo-drawer-item-gap);\n  padding: var(--rv-todo-drawer-item-padding-y) 0;\n  font-size: var(--rv-todo-drawer-font-size);\n  line-height: var(--rv-todo-drawer-line-height);\n  color: var(--rv-todo-drawer-text);\n  white-space: nowrap;\n}\n\n.rv-todo-drawer-item-icon {\n  font-size: var(--rv-todo-drawer-icon-size);\n  color: var(--accent-dim, var(--text-dim));\n  flex-shrink: 0;\n}\n\n.rv-todo-drawer-item-text {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* In-progress emphasis */\n.rv-todo-drawer-item--in_progress {\n  color: var(--rv-todo-drawer-accent);\n}\n\n.rv-todo-drawer-item--in_progress .rv-todo-drawer-item-icon {\n  color: var(--rv-todo-drawer-accent);\n}\n\n/* Completed dimming */\n.rv-todo-drawer-item--completed {\n  opacity: 0.6;\n}\n\n.rv-todo-drawer-item--completed .rv-todo-drawer-item-text {\n  text-decoration: line-through;\n}\n\n/* Scrollbar styling inside expanded drawer */\n.rv-todo-drawer--expanded .rv-todo-drawer-list::-webkit-scrollbar {\n  width: var(--rv-todo-drawer-scrollbar-width);\n}\n\n.rv-todo-drawer--expanded .rv-todo-drawer-list::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.rv-todo-drawer--expanded .rv-todo-drawer-list::-webkit-scrollbar-thumb {\n  background: var(--rv-todo-drawer-scroll-thumb);\n  border-radius: var(--rv-todo-drawer-scrollbar-radius);\n}\n/*\n * ThreadedChat — one explicit rail + Main Chat composition.\n *\n * Presentation-only. Uses existing CSS variables so the visual language is\n * unchanged; production keeps the shell grid tracks and only explicit\n * view-bound hosts/fixtures use this wrapper.\n */\n\n.rv-threaded-chat {\n  display: flex;\n  align-items: stretch;\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  background: var(--bg-panel, transparent);\n}\n\n.rv-threaded-chat > .rv-sidebar {\n  flex: 0 0 auto;\n}\n\n.rv-threaded-chat > .rv-chat-area {\n  flex: 1 1 auto;\n  min-width: 0;\n}\n/* SPEC-26c-2: Sidebar collapse/expand chrome */\n\n/* Anchor the absolute collapse button to the sidebar */\n.rv-sidebar {\n  position: relative;\n  border-radius: var(--thread-container-border-radius, 0px);\n}\n\n.rv-sidebar--active {\n  /* no active-wire highlight — .rv-chat-area--inactive opacity dimming is enough */\n}\n\n.rv-thread-sidebar-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-xs, 4px);\n  width: 100%;\n  min-height: 47px;\n  margin: 0 0 var(--space-md, 12px);\n}\n\n.rv-sidebar-peek-dock {\n  position: absolute;\n  top: 6px;\n  left: 4px;\n}\n\n.rv-thread-view-select {\n  align-self: flex-start;\n  width: auto;\n  max-width: calc(100% - 32px);\n  margin: 15px 0 0 7px;\n  padding: var(--space-xs, 4px) 2px var(--space-xs, 4px) 0;\n  border: none;\n  border-radius: var(--radius-sm, 6px);\n  background: var(--sidebar-surface-bg, var(--panel-chrome-bg));\n  color: var(--thread-heading-color, var(--thread-foreground-color, var(--chrome-accent, var(--text-dim))));\n  font: inherit;\n  font-size: 18px;\n  font-weight: 700;\n  text-align: left;\n  text-align-last: left;\n  cursor: pointer;\n  transition:\n    background var(--transition-fast, 150ms) ease,\n    color var(--transition-fast, 150ms) ease;\n}\n\n.rv-thread-view-select:hover {\n  background: var(--glass-sm, rgba(255, 255, 255, 0.06));\n  color: var(--thread-selected-bg, var(--accent-dim, var(--theme-primary)));\n}\n\n.rv-thread-view-select:focus-visible {\n  outline: 2px solid var(--thread-selected-bg, var(--accent-dim, var(--theme-primary)));\n  outline-offset: 2px;\n}\n\n.rv-sidebar .rv-sidebar-peek-dock {\n  color: var(--thread-foreground-color, var(--chrome-accent, var(--text-dim)));\n}\n\n.rv-sidebar .rv-sidebar-peek-dock:hover,\n.rv-sidebar .rv-sidebar-peek-dock[aria-expanded=\"true\"] {\n  color: var(--thread-selected-bg, var(--accent-dim, var(--theme-primary)));\n}\n\n.rv-sidebar .rv-sidebar-peek-dock:focus-visible {\n  outline-color: var(--thread-selected-bg, var(--theme-primary));\n}\n\n.rv-thread-view-select option {\n  background: var(--sidebar-surface-bg, var(--panel-chrome-bg));\n  color: var(--thread-heading-color, var(--thread-foreground-color, var(--chrome-accent, var(--text-dim))));\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.rv-thread-list-empty {\n  cursor: default;\n}\n\n.rv-thread-menu-btn .material-symbols-outlined {\n  font-size: 18px;\n}\n\n/* SPEC-04 §8: one non-primary group member in the ThreadRail kebab. The\n   member label opens/focuses its Side Chat; the trailing link control copies\n   the exact-member version-1 application link. */\n.rv-thread-menu-member {\n  display: flex;\n  align-items: center;\n  gap: var(--space-xs, 4px);\n}\n\n.rv-thread-menu-member .rv-dropdown-item {\n  flex: 1 1 auto;\n  min-width: 0;\n}\n\n.rv-thread-menu-member-link {\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-xs, 4px);\n  border: none;\n  background: transparent;\n  color: var(--thread-foreground-color, var(--chrome-accent, var(--text-secondary)));\n  cursor: pointer;\n}\n\n.rv-thread-menu-member-link:hover {\n  color: var(--thread-selected-bg, var(--accent-dim, var(--theme-primary)));\n}\n\n.rv-thread-menu-member-link .material-symbols-outlined {\n  font-size: 16px;\n}\n\n.rv-thread-menu-members-label {\n  padding: var(--space-xs, 4px) var(--space-sm, 8px);\n  font-size: 12px;\n  font-weight: 700;\n  color: var(--thread-foreground-color, var(--chrome-accent, var(--text-secondary)));\n}\n\n.rv-sidebar .rv-new-chat-btn {\n  justify-content: flex-start;\n  border: none;\n  color: var(--thread-heading-color, var(--thread-foreground-color, var(--chrome-accent, var(--text-dim))));\n  text-align: left;\n}\n\n.rv-sidebar .rv-chat-item-text,\n.rv-sidebar .rv-chat-item-meta {\n  color: var(--thread-text-color, var(--thread-foreground-color, var(--chrome-accent, var(--text-dim))));\n}\n\n.rv-sidebar .rv-new-chat-btn .material-symbols-outlined {\n  flex: 0 0 auto;\n}\n\n.rv-sidebar .rv-new-chat-btn span:last-child {\n  font-size: 15px;\n  font-weight: 700;\n}\n\n.rv-thread-list-divider {\n  flex: 0 0 auto;\n  height: 1px;\n  margin: 0 0 var(--space-md, 12px);\n  background: var(--thread-foreground-color, var(--neutral-chrome-border, rgba(255, 255, 255, 0.12)));\n}\n\n.rv-sidebar .rv-thread-menu-btn,\n.rv-sidebar .rv-thread-menu-btn:hover {\n  color: var(--thread-foreground-color, var(--chrome-accent, var(--text-secondary)));\n}\n\n/* SPEC-26c-2: collapsed rail — sidebar collapses to a 40px strip\n   with only an expand icon. Width comes from the inline CSS variable\n   on .rv-panel (set to 40px when collapsed). Hide child content except\n   the expand affordance. */\n.rv-sidebar.rv-sidebar--collapsed {\n  width: 0;\n  min-width: 0;\n  padding: 0;\n  overflow: visible;\n  background: transparent;\n  z-index: var(--z-dropdown, 100);\n}\n\n.rv-sidebar-peek-panel {\n  po