+  }
+};
+for (const host of ['main', 'side']) for (const kind of ['clipboard-top', 'clipboard-row', 'recent-top', 'recent-row', 'gallery']) {
+  test(`A06 ${host} ${kind} begins at actual action and uses its own composer`, async ({ page }) => {
+    await mount(page);
