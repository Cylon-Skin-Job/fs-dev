+  }
+  if (kind === 'recent-row') {
+    await scope.getByRole('menuitem', { name: 'Browse recent edits' }).click();
+    await page.locator('.rv-hover-icon-modal-row').filter({ hasText: 'recent.ts' }).click();
+  }
+  if (kind === 'gallery') {
