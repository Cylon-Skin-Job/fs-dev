/* ═══════════════════════════════════════════════════════════════════════════
   File-viewer chrome — color/background/border layer
   ═══════════════════════════════════════════════════════════════════════════
   Lifted out of ai/<machine>/System/Views/<view-folder>/styles/layout.css per the
   themes-and-state spec ("per-view files are layout-only"). Every value here
   resolves to a theme variable; nothing is hardcoded.

   Selectors and pseudo-class semantics mirror the per-view layout file —
   this layer applies color where the layout file applies structure.

   Token map:
     --file-viewer-chrome-border = neutral chrome border (Border sliders)
     --file-tree-sidebar-bg      = panel-chrome surface
     --content-attenuated        = Content Contrast luminance + Content Tint
*/

/* ── Local theme aliases (scoped to the file-viewer layout root) ── */
.rv-file-explorer-layout {
  --file-viewer-chrome-border: var(--neutral-chrome-border, rgba(255, 255, 255, 0.12));
  --file-tree-sidebar-bg:      var(--panel-chrome-bg, #1a1a1a);
}

/* ── Empty states (file picker not yet showing a viewer) ── */
.rv-file-explorer-main:empty {
  background: var(--bg-solid);
}

.rv-file-explorer-empty {
  color: var(--text-dim);
  background: var(--bg-solid);
}

.rv-file-explorer-error {
  color: var(--text-error, #ef4444);
}

/* ── File tree sidebar surface ── */
.rv-file-tree-sidebar {
  background: var(--sidebar-surface-bg, #161616);
}

.rv-file-tree-footer {
  background: linear-gradient(
    to bottom,
    transparent 0%,
    var(--sidebar-surface-bg, #161616) 10%,
    var(--sidebar-surface-bg, #161616) 100%
  );
}

.rv-file-hidden-toggle {
  background: var(--sidebar-surface-bg, #161616);
  border-color: var(--chrome-accent, var(--neutral-chrome-border, rgba(255, 255, 255, 0.12)));
  color: var(--chrome-accent, var(--text-dim));
}

.rv-file-hidden-toggle:hover {
  background: var(--glass-sm, rgba(255, 255, 255, 0.06));
  border-color: var(--accent-dim, var(--chrome-accent));
  color: var(--accent-dim, var(--text-white));
}

.rv-file-hidden-toggle[aria-pressed="true"] {
  color: var(--chrome-accent, var(--text-dim));
}

.rv-file-hidden-toggle[aria-pressed="true"] .material-symbols-outlined {
  font-variation-settings: 'FILL' 1;
}

.rv-file-tree-item--hidden-folder::after {
  background: color-mix(in srgb, var(--accent-dim, var(--theme-primary, #39628e)) 42%, transparent);
}

/* ── Open file: same surface as document code canvas ── */
.rv-file-viewer {
  background: var(--document-bg, #161616);
}

/* ── Header rail + chrome divider beneath tabs ──
   Header rail matches the sidebar surface so the area around the nav
   buttons and the gap where no tabs are visible reads as a continuation
   of the workspace's sidebar/rail chrome. */
.rv-file-viewer-header {
  background: var(--sidebar-surface-bg, #161616);
}

.rv-file-viewer-header::after {
  /* Chrome divider (between the tab strip and the content frame).
   * Driven by the Border sliders via --file-viewer-chrome-border. */
  background: var(--file-viewer-chrome-border, var(--neutral-chrome-border, rgba(255, 255, 255, 0.12)));
}

/* ── Header nav buttons (chevrons) ── */
.rv-file-viewer-nav .rv-nav-btn {
  background: var(--sidebar-surface-bg, #161616);
  color: var(--text-dim);
}

.rv-file-viewer-nav .rv-nav-btn:hover:not(:disabled) {
  color: var(--text-white);
}

/* ── Tab strip rail + tab chrome ──
   Strip surface matches the sidebar so the area between/beside tabs reads
   as a continuation of the workspace's sidebar chrome. Individual tab chips
   keep --file-tree-sidebar-bg so they read as raised elements on the rail. */
.rv-file-viewer-tabs {
  background: var(--sidebar-surface-bg, #161616);
}

.rv-file-viewer-tab {
  border-left:  1px solid var(--file-viewer-chrome-border);
  border-right: 1px solid var(--file-viewer-chrome-border);
  background-color: var(--file-tree-sidebar-bg, #1a1a1a);
}

.rv-file-viewer-tab.active {
  background-color: var(--document-bg, #161616);
}

/* Tab name + icon — driven by the picker's "Chrome settings" sliders
   (Luminance + Tint) via --chrome-accent. */
.rv-file-viewer-tab .rv-tab-icon {
  color: var(--chrome-accent, var(--text-dim));
}

.rv-file-viewer-tab .rv-tab-name {
  color: var(--chrome-accent, var(--text-dim));
}

.rv-file-viewer-tab:not(.active) .rv-tab-name {
  color: var(--chrome-accent, var(--text-dim));
}

.rv-file-viewer-tab .rv-tab-close {
  color: var(--text-dim);
}

.rv-file-viewer-tab .rv-tab-close:hover {
  background: var(--glass-md, rgba(255, 255, 255, 0.1));
  color: var(--text-white);
}

/* ── Filename info row + content divider ── */
.rv-file-viewer-info {
  background: var(--document-bg, #161616);
  /* Content divider (between filename row and the code body). Inherits the
     wiki's border paradigm (--content-highlight) so file-viewer in-content
     borders match the wiki's borders. Not driven by the Border sliders. */
  border-bottom: 1px solid var(--content-highlight, rgba(192, 160, 224, 0.16));
  /* Filename row text — driven by the picker's "Chrome settings" sliders
     via --chrome-accent. The border above stays on the wiki content paradigm. */
  color: var(--chrome-accent, var(--text-dim));
}

/* ── Code-content fill ── */
.rv-file-viewer-content {
  background: var(--document-bg, #161616);
}
