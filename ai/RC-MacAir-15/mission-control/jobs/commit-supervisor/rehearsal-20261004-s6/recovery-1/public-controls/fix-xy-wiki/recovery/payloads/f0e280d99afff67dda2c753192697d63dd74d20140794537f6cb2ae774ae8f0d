.rv-checklist { color: var(--text-primary, #ddd); background: var(--bg-primary, #222); padding: var(--space-lg, 24px); font: var(--font-body, 16px system-ui); }
.rv-checklist-row { display: flex; gap: var(--space-sm, 8px); padding: var(--space-sm, 8px); }
.rv-checklist-reset { color: var(--text-primary, #ddd); background: var(--bg-secondary, #333); margin-top: var(--space-sm, 8px); padding: var(--space-sm, 8px); font: inherit; cursor: pointer; }
