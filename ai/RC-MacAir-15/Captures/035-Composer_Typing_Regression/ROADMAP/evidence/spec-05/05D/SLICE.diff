+  assert.match(source('thread/HistoryFile.js'), /mirror-journal/);
+  for (const owner of ['runtime-dispatch', 'runtime-stop', 'runtime-activation', 'automation-drain']) {
+    assert.match(source(`thread/${owner}.js`), /threadRuntimeManager/);
+  }
+});
