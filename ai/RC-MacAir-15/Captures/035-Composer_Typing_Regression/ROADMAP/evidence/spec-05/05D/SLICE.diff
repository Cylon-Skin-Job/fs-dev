+  } catch (_graceError) {
+    try { wireProcess?.kill?.('SIGKILL'); } catch (_signalError) {}
+    await awaitBoundedProviderTermination(terminationPromise(), forceMs);
+  } finally {
+    eventWaiter?.cancel();
+  }
+}
