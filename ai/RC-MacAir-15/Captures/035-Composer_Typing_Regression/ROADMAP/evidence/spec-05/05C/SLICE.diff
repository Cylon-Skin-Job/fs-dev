+    if (wire) return { wire, deferReason: null };
+    threadRuntimeManager.markOwnedState(ownership, RUNTIME_STATES.COLD);
+  } else {
+    const deferReason = getDeferReason(state);
+    if (deferReason) {
+      return { wire: null, deferReason };
+    }
+  }
