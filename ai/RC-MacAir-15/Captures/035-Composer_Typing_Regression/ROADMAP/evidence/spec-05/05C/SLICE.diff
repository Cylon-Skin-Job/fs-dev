+    session,
+    wireLifecycle,
+    projectRoot,
+    spawnAndSetupWire,
+    runtimeKey,
+    threadId,
+    workspaceBinding,
+    target,
+    suppressBusyError: true,
+  });
+}
+
+
+module.exports = { ensureReadyRuntime, warmRuntimeForIntent };
