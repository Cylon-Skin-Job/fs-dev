+  let reservation;
+  let wire;
+  let ownership;
+  try {
+    reservation = await ensureReadyRuntime({
+      ws,
+      session,
+      wireLifecycle,
+      projectRoot,
+      spawnAndSetupWire,
+      runtimeKey,
+      threadId,
+      workspaceBinding,
+      target,
+      reserveForPrompt: true,
+      requestId,
